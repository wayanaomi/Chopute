# ---------------------------------------------------------------------------
# Chopute — environment variables
# Copy this file to .env for local development: `cp .env.example .env`
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
# Public base URL of the app. Used to build absolute links (referral URLs,
# OAuth callback URLs, payment callback URLs, emails). No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional. E.164 phone number (digits only, no "+") to show a WhatsApp
# contact link in the footer. Leave blank to hide it.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string, e.g.
# postgresql://USER:PASSWORD@HOST:5432/chopute?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chopute?schema=public"

# --- Auth.js (NextAuth) ------------------------------------------------------
# Generate with: npx auth secret   (or) openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Apify (real business data) ---------------------------------------------
# Personal API token from https://console.apify.com/account/integrations
APIFY_API_TOKEN=""
# Actor id/slug that scrapes Google Maps business listings, e.g.
# "compass/crawler-google-places" (the actor used in the client-provided
# methodology). Configurable so the provider can be swapped without a
# code change.
APIFY_ACTOR_ID="compass/crawler-google-places"
# Max time (seconds) to wait for a single Apify actor run before giving up.
APIFY_RUN_TIMEOUT_SECONDS="120"
# Cap on results per search (cost control).
APIFY_MAX_RESULTS_PER_SEARCH="200"

# --- Payments (Paystack — one-time $25 unlimited access) --------------------
# https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Unlimited-access price. Charged in NGN via Paystack; USD figure is used
# only for on-screen marketing copy ("$25 One-Time").
UNLIMITED_ACCESS_PRICE_NGN="38000"
UNLIMITED_ACCESS_PRICE_USD="25"

# --- Email (transactional email, e.g. password reset) -----------------------
# Any SMTP-compatible provider (Resend, Postmark, SES, etc).
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Chopute <no-reply@chopute.com>"
